# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交

# 必填：大模型 API Key（不填则使用内置 mock 规则兜底）
LLM_API_KEY=

# 选填：OpenAI 兼容接口地址（默认 https://api.openai.com/v1）
# DeepSeek:        https://api.deepseek.com/v1
# 智谱 GLM:        https://open.bigmodel.cn/api/paas/v4
# Moonshot Kimi:   https://api.moonshot.cn/v1
# 阿里通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenRouter:      https://openrouter.ai/api/v1
# 本地 Ollama:     http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# 选填：模型名（默认 gpt-4o-mini）
LLM_MODEL=openrouter/free

# —— Gitea 联动（学生分支直连模型：花名册导入时联动建号/分支保护/协作者授权；三项齐备才启用）——
# GITEA_URL=http://127.0.0.1:3001
# GITEA_ADMIN_TOKEN=
# GITEA_REPO=classroom/exercises

# 选填：学生机可达的 Gitea 地址（与 GITEA_URL 可不同：服务端走 127.0.0.1，学生走内网 IP）。
# 配置后身份校验响应下发 gitRepoUrl = ${GITEA_PUBLIC_BASE}/${GITEA_REPO}.git，学生机无需配置 pylearner.gitRepoUrl
# GITEA_PUBLIC_BASE=http://192.168.1.100:3001
