# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交

# 必填：大模型 API Key（不填则使用内置 mock 规则兜底）
LLM_API_KEY=

# 选填：OpenAI 兼容接口地址（默认 https://api.openai.com/v1）
# DeepSeek:        https://api.deepseek.com/v1
# 智谱 GLM:        https://open.bigmodel.cn/api/paas/v4
# Moonshot Kimi:   https://api.moonshot.cn/v1
# 阿里通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenRouter:      https://openrouter.ai/api/v1
# 本地 Ollama:     http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# 选填：模型名（默认 gpt-4o-mini）
LLM_MODEL=openrouter/free

# —— 作业 git 仓库（不配则作业功能停用，监控流不受影响）——
GIT_REPO_URL=
# GIT_REPO_DIR=data/exercises-repo
GIT_SYNC_INTERVAL_MS=60000
GIT_AUTHOR_EMAIL_DOMAIN=classroom
